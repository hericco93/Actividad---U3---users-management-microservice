{
  "info": {
    "name": "Users Management - Países API (Ejercicio 26)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "paisId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login Admin (Obtener JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.token) { pm.collectionVariables.set('token', res.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin1234!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "2. Crear País (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.id) { pm.collectionVariables.set('paisId', res.id); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Colombia\",\n  \"presidente\": \"Gustavo Petro\",\n  \"continente\": \"América del Sur\",\n  \"nombreHimno\": \"Oh Gloria Inmarcesible\",\n  \"numHabitantes\": 52215503,\n  \"numDepartamentos\": 32,\n  \"numMunicipios\": 1123,\n  \"idiomaPrincipal\": \"Español\",\n  \"numUniversidades\": 300,\n  \"tipoDemocracia\": \"República presidencialista\"\n}"
        },
        "url": "{{baseUrl}}/api/paises"
      }
    },
    {
      "name": "3. Listar Países (GET All)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/paises"
      }
    },
    {
      "name": "4. Buscar País por ID (GET By Id)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/paises/{{paisId}}"
      }
    },
    {
      "name": "5. Actualizar País (PUT)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Colombia\",\n  \"presidente\": \"Presidente Actualizado\",\n  \"continente\": \"América del Sur\",\n  \"nombreHimno\": \"Oh Gloria Inmarcesible\",\n  \"numHabitantes\": 53000000,\n  \"numDepartamentos\": 32,\n  \"numMunicipios\": 1123,\n  \"idiomaPrincipal\": \"Español\",\n  \"numUniversidades\": 310,\n  \"tipoDemocracia\": \"República presidencialista\"\n}"
        },
        "url": "{{baseUrl}}/api/paises/{{paisId}}"
      }
    },
    {
      "name": "6. Eliminar País (DELETE)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
        },
        "method": "DELETE",
        "url": "{{baseUrl}}/api/paises/{{paisId}}"
      }
    }
  ]
}